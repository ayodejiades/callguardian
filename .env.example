# Copy to .env and fill in. Never commit .env — see .gitignore.

# Set to 1 to run entirely offline: CALL-E calls return fixtures/calle/*.json instead of
# dialing, and the "simulate a US business afternoon" / tamper-log demo controls only work
# when this is 1 (see api/main.py:_resolve_now and /api/audit/tamper).
DEMO_MODE=0

# Where this app is deployed once `make deploy` has run.
DEPLOY_URL=http://localhost:8000

# CALL-E — required for live calls (DEMO_MODE=0). Get an account and CLI login at
# CALL-E's install guide; the account comes with 20 free calls.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_ACCOUNT_EMAIL=

# Signs the dashboard's session cookie. Any long random string; must be set to something
# real before a public deploy — the checked-in default is dev-only and well-known.
SESSION_SECRET=dev-only-secret-change-me
